# Supabase Dashboard > Connect > Session pooler (IPv4 compatible).
# URL-encode special characters in the password. Keep TLS enabled remotely.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
ALLOWED_ORIGINS=http://localhost:3000
PORT=8080

# Tests use an isolated schema on a dedicated PostgreSQL database.
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/thaifood_test?sslmode=disable
